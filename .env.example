# Copy this file to .env and choose a backend. .env is git-ignored.

# Option 1: local model through Ollama (no API key; install Ollama, then
#           `ollama pull qwen2.5:1.5b` and `ollama pull nomic-embed-text`)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Option 2: Mistral API
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key
